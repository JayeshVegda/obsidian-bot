# ─────────────────────────────────────────────────────────────────────────────
# Vault Bot — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Environment
NODE_ENV=development

# Server
APP_DOMAIN=localhost
PORT=4000
HOST=0.0.0.0
BODY_LIMIT=35mb

# Auth — generate with: openssl rand -hex 32
API_SECRET_KEY=change-this-to-a-long-random-secret-at-least-16-chars

# Vault Paths
# VAULT_PATH: absolute path to your Obsidian vault folder
VAULT_PATH=/home/youruser/obsidian-vault

# VAULT_INDEX_PATH: local path OR a raw GitHub URL (read-only)
# Local:  /home/youruser/vault-index/vault-index.json
# Remote: https://raw.githubusercontent.com/user/vault-index/main/vault-index.json
VAULT_INDEX_PATH=/home/youruser/vault-index/vault-index.json

# GITHUB_REPO_PATH: local path to the git repo for pushing the index
GITHUB_REPO_PATH=/home/youruser/vault-index

# Optional: public URL to the raw vault index
VAULT_INDEX_GITHUB_URL=https://raw.githubusercontent.com/youruser/vault-index/main/vault-index.json

# CORS — comma-separated origins allowed to call the API
# In production set this to your frontend's domain
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info
